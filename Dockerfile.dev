# Base the image on Rocky Linux (Red Hat compatible)
FROM rockylinux:9

USER root

RUN useradd -m -r boa

RUN yum install -y epel-release

RUN yum install --allowerasing -y \
    glibc-langpack-en \
    less \
    make \
    postgresql \
    postgresql-devel \
    procps \
    python3 \
    python3-devel \
    python3-pip \
    redhat-rpm-config \
    which

RUN pip3 install wheel

# Create ABOA runtime folders. The source code itself is expected to be bind-mounted
# by compose_dev.yml at /aboa so live host edits are immediately visible.
RUN mkdir /log \
    /resources_path \
    /datamodel \
    /aboa_archive \
    /aboa

RUN chown -R boa:boa /log /resources_path /datamodel /aboa_archive /aboa

# Keep dependencies outside the bind-mounted source tree. Python imports prefer
# /aboa/src, so source changes on the host are used without rebuilding the image.
RUN mkdir /usr/local/python-packages
RUN chown -R boa:boa /usr/local/python-packages

RUN pip3 install --target=/usr/local/python-packages \
    "sqlalchemy==1.3.22" \
    "psycopg2-binary==2.9.11" \
    "python-dateutil==2.9.0.post0" \
    "lxml==6.0.2" \
    "pytest==8.4.2" \
    "pytest-cov==7.0.0"

ENV PYTHONPATH=/aboa/src:/usr/local/python-packages
ENV PATH="/aboa/src/scripts:/usr/local/python-packages/bin:${PATH}"

# Development paths point directly to the bind-mounted checkout.
ENV ABOA_RESOURCES_PATH=/aboa/src/aboa/config
ENV ABOA_LOG_PATH=/log
ENV ABOA_DEFAULT_ARCHIVE_PATH=/aboa_archive
ENV PYTHONDONTWRITEBYTECODE=1
ENV LC_ALL=en_US.utf-8
ENV LANG=en_US.utf-8

WORKDIR /aboa

USER boa

# Install datamodel
RUN ln -s /aboa/src/aboa/datamodel/aboa_data_model.sql /datamodel

CMD ["/bin/bash", "-c", "/aboa/src/scripts/start_aboa.sh"]
