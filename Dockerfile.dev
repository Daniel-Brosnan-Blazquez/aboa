# Base the image on Rocky Linux (Red Hat compatible)
FROM rockylinux:9

# Match the host user's IDs so bind-mounted files have the expected ownership.
ARG UID_HOST_USER=1000
ARG GID_HOST_USER=1000

USER root

RUN groupadd --gid "${GID_HOST_USER}" boa \
    && useradd -m --uid "${UID_HOST_USER}" --gid "${GID_HOST_USER}" boa

RUN yum install -y epel-release

RUN yum install --allowerasing -y \
    glibc-langpack-en \
    less \
    make \
    postgresql \
    postgresql-devel \
    procps \
    python3 \
    python3-devel \
    python3-pip \
    redhat-rpm-config \
    which

RUN pip3 install wheel

# Create ABOA runtime folders. The source code itself is expected to be bind-mounted
# by compose_dev.yml at /aboa so live host edits are immediately visible.
RUN mkdir /log \
    /resources_path \
    /datamodel \
    /aboa_archive \
    /aboa

# Install ABOA in editable mode so the mounted checkout supplies live Python code.
COPY . /aboa

RUN python3 -m pip install --use-pep517 --editable "/aboa[tests]"

RUN chown -R boa:boa /log /resources_path /datamodel /aboa_archive /aboa

ENV PATH="/aboa/src/aboa/scripts:${PATH}"

# Development paths point directly to the bind-mounted checkout.
ENV ABOA_RESOURCES_PATH=/aboa/src/aboa/config
ENV ABOA_LOG_PATH=/log
ENV ABOA_DEFAULT_ARCHIVE_PATH=/aboa_archive
ENV PYTHONDONTWRITEBYTECODE=1
ENV LC_ALL=en_US.utf-8
ENV LANG=en_US.utf-8

WORKDIR /aboa

USER boa

# Install datamodel
RUN ln -s /aboa/src/aboa/datamodel/aboa_data_model.sql /datamodel

CMD ["/bin/bash", "-c", "/aboa/src/aboa/scripts/start_aboa.sh"]
